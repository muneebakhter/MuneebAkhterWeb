@page "/doge"
@using MuneebAkhterWeb.Shared
@inject HttpClient Http

<PageTitle>DOGE Assessment</PageTitle>

<h1>DOGE Assessment</h1>
<hr />
<h2>Agency Regulation Sizes</h2>

<input class="form-control mb-2" placeholder="Filter agencies..."
       @bind="search" />

@if (agencies is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th @onclick="() => SortBy(nameof(AgencyData.AgencyName))">
                    Agency @SortIndicator(nameof(AgencyData.AgencyName))
                </th>
                <th @onclick="() => SortBy(nameof(AgencyData.RegulationSizeMb))">
                    Size&nbsp;(MB) @SortIndicator(nameof(AgencyData.RegulationSizeMb))
                </th>
                <th @onclick="() => SortBy(nameof(AgencyData.LastUpdated))">
                    Last&nbsp;Updated @SortIndicator(nameof(AgencyData.LastUpdated))
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Filtered())
            {
                <tr>
                    <td>@a.AgencyName</td>
                    <td>@($"{a.RegulationSizeMb:F2} MB")</td>
                    <td>@a.LastUpdated.ToLocalTime().ToString("d")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AgencyData>? agencies;
    private string? search;
    private string sortColumn = nameof(AgencyData.AgencyName);
    private bool sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        agencies = await Http.GetFromJsonAsync<List<AgencyData>>("/api/agencies");
    }

    IEnumerable<AgencyData> Filtered()
    {
        if (agencies is null) return Enumerable.Empty<AgencyData>();

        IEnumerable<AgencyData> q = agencies;

        if (!string.IsNullOrWhiteSpace(search))
            q = q.Where(a => a.AgencyName.Contains(search, StringComparison.OrdinalIgnoreCase));

        q = sortColumn switch
        {
            nameof(AgencyData.RegulationSizeMb) => sortAsc ? q.OrderBy(a => a.RegulationSizeMb)
                                                         : q.OrderByDescending(a => a.RegulationSizeMb),
            nameof(AgencyData.LastUpdated) => sortAsc ? q.OrderBy(a => a.LastUpdated)
                                                         : q.OrderByDescending(a => a.LastUpdated),
            _ => sortAsc ? q.OrderBy(a => a.AgencyName)
                                                         : q.OrderByDescending(a => a.AgencyName)
        };

        return q;
    }

    void SortBy(string col)
    {
        if (sortColumn == col) sortAsc = !sortAsc;
        else { sortColumn = col; sortAsc = true; }
    }

    RenderFragment SortIndicator(string col) => builder =>
    {
        if (sortColumn != col) return;
        builder.AddContent(0, sortAsc ? "▲" : "▼");
    };
}
